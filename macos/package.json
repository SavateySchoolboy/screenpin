{
  "name": "screenpin-macos",
  "version": "1.0.0",
  "description": "ScreenPin for macOS",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check core.js && node --check preload.js && node --check renderer.js && node --test test/*.test.js",
    "build:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.screenpin.desktop",
    "productName": "ScreenPin",
    "files": [
      "main.js",
      "core.js",
      "preload.js",
      "renderer.js",
      "window.html",
      "styles.css",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "ScreenPin копирует выделенный текст для создания QR-кода."
      }
    }
  }
}
